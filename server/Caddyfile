# Qaf API - Production Caddy Configuration with Automatic Free HTTPS
# Replace api.yourdomain.com with your domain (e.g. api.qafpoetry.ir)

api.yourdomain.com {
    # Compression (zstd & gzip)
    encode zstd gzip

    # Reverse proxy to the Go backend service
    reverse_proxy 127.0.0.1:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security & CORS headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, Accept, Origin, X-Requested-With"
    }

    # Structured access logging
    log {
        output file /var/log/caddy/qaf_api.log {
            roll_size 50mb
            roll_keep 5
        }
    }
}
