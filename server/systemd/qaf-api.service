[Unit]
Description=Qaf Persian Literature API Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/qaf/server
ExecStart=/opt/qaf/server/qaf-api
Restart=always
RestartSec=5s
Environment=PORT=8080
Environment=DB_PATH=/opt/qaf/server/qaf.db
LimitNOFILE=65535

# Security hardening
ProtectSystem=full
ProtectHome=false
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
